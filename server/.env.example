# HTTP
PORT=3000

# MySQL / TypeORM
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=mini_ecommerce
DB_PASSWORD=mini_ecommerce_password
DB_NAME=mini_ecommerce
# Required for managed databases such as TiDB Cloud public endpoints.
DB_SSL=false
# Optional CA bundle for managed providers using a private CA. The file is
# mounted at runtime and must not be copied into the image.
# DB_SSL_CA_PATH=/run/secrets/mysql-ca.pem
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_POOL_QUEUE_LIMIT=50
DB_IDLE_TIMEOUT_MS=60000
DB_SLOW_QUERY_MS=1000

# Backup jobs require 32 random bytes encoded as base64. Keep this value only
# in the deployment secret manager, never in this file or the image.
# BACKUP_ENCRYPTION_KEY=base64-of-exactly-32-random-bytes
# BACKUP_DIR=./backups
# RESTORE_DRILL_DB_NAME=mini_ecommerce_restore_drill

# Isolated schema for `npm run test:e2e`. MUST differ from DB_NAME — the suite
# refuses to run otherwise, because it truncates every table between tests.
DB_NAME_TEST=mini_ecommerce_test

# JWT development secrets (replace outside local development, minimum 16 chars)
JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret

# Allowed browser origin. Set this to the Vercel deployment URL in production.
FRONTEND_URL=http://localhost:5173

# Optional SMTP transport. Provide the entire group to send real password-reset
# and verification emails. Port 465 uses SMTP_SECURE=true; port 587 uses false.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=replace-with-an-app-password
# SMTP_FROM=MiniShop <no-reply@example.com>

# Admin creation is opt-in. The container never creates a default public
# credential. Set both values for one deploy, then remove ADMIN_PASSWORD.
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_NAME=Store Owner

# `json` for one-object-per-line container logs, `pretty` for Nest's colours.
# Defaults to json when NODE_ENV=production, pretty otherwise.
LOG_FORMAT=pretty

# HTTP hardening. Production defaults trust one reverse-proxy hop, limits JSON
# and form bodies to 1 MiB, and disables Swagger unless explicitly enabled.
# CORS_ORIGINS=https://shop.example.com,https://www.shop.example.com
# TRUST_PROXY_HOPS=1
# REQUEST_BODY_LIMIT_BYTES=1048576
# SWAGGER_ENABLED=false

# Delivery pricing. Both optional; left unset, every order ships free and
# totals match a deployment that predates shipping fees. FREE_SHIPPING_THRESHOLD
# compares against the subtotal AFTER any coupon discount.
# SHIPPING_FLAT_FEE=30000
# FREE_SHIPPING_THRESHOLD=500000

# Turns off every auth/coupon rate limit. For the e2e suite and load tests only
# — never set this in a deployment.
# RATE_LIMIT_DISABLED=false

# Stripe Test Mode. Create a restricted test key and forward webhooks to
# /api/payments/webhooks/stripe. Never expose either value to the browser.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
