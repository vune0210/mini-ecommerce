# Local Docker only. Copy to .env at the repository root; .env is ignored.
# Replace every value before starting Compose. Never reuse these in staging or production.
DEV_DB_PASSWORD=generate-a-random-local-password
DEV_DB_ROOT_PASSWORD=generate-another-random-local-password
DEV_JWT_ACCESS_SECRET=generate-an-independent-48-byte-base64-value
DEV_JWT_REFRESH_SECRET=generate-another-independent-48-byte-base64-value
